<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:clipToOutline="true"><ImageView android:id="@+id/widget_surface" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" /><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp"><ImageView android:layout_width="60dp" android:layout_height="14dp" android:layout_marginBottom="4dp" android:src="@drawable/widget_brand" android:contentDescription="Glyph Music" /><ImageView android:id="@+id/widget_record" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginVertical="8dp" android:src="@drawable/widget_album_placeholder" android:scaleType="fitCenter" android:contentDescription="Album artwork" /><TextView android:id="@+id/track_title" android:layout_width="match_parent" android:layout_height="22dp" android:text="First Light" android:textColor="#FFFFFF" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/track_artist" android:layout_width="match_parent" android:layout_height="20dp" android:text="The quiet hours" android:textColor="#CECECC" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" /><LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageButton android:id="@+id/previous_track" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="4dp" android:background="@android:color/transparent" android:src="@drawable/widget_previous" android:contentDescription="Previous track" />
    <ImageButton android:id="@+id/play_pause" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/widget_play_background" android:src="@drawable/widget_play" android:contentDescription="Play" />
    <ImageButton android:id="@+id/next_track" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="4dp" android:background="@android:color/transparent" android:src="@drawable/widget_next" android:contentDescription="Next track" />
</LinearLayout><LinearLayout android:id="@+id/widget_shortcuts" android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal">
    <TextView android:id="@+id/queue_shortcut" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Queue" android:textSize="11sp" android:textColor="#E1E1E4" />
    <TextView android:id="@+id/playlists_shortcut" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Playlists" android:textSize="11sp" android:textColor="#E1E1E4" />
</LinearLayout></LinearLayout></FrameLayout>