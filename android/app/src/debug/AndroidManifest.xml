<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <instrumentation android:name=".WidgetLayoutCheck" android:targetPackage="app.glyph.glyph_music" android:label="Glyph widget layout checks" />
    <instrumentation android:name=".WidgetPlaybackCheck" android:targetPackage="app.glyph.glyph_music" android:label="Glyph widget playback check" />
    <instrumentation android:name=".PhoneAudioCheck" android:targetPackage="app.glyph.glyph_music" android:label="Glyph phone audio check" />
</manifest>
